\mix(c = 7)
\mix(8, c = 5)
\mix(...(4, 5))

\ fun inc(n) = n + 1
\ fun via_call(v = inc(41)) = v
\via_call()
\via_call(0)

\ let flag = 0
\ fun lazy(v, unused = cowel_var_set("flag", 1)) = v
\lazy(11, 0)
\lazy(12, 9)
\cowel_var_get("flag")
