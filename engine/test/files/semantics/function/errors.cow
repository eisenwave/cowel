\test_input{
\ fun f1(x) = x
\test_expect_error("type.mismatch"){a\f1(1, 2)}
\ fun f2(x, y) = x + y
\test_expect_error("type.mismatch"){b\f2(1)}
\ fun f3(x) = x
\test_expect_error("type.mismatch"){c\f3(y = 1)}
\ fun f4(x) = x
\test_expect_error("type.mismatch"){d\f4(x = 1, x = 2)}
\ fun f5(x) = x
\test_expect_error("type.mismatch"){e\f5(1){2}}
\ fun dup() = 0
\test_expect_fatal("function.duplicate"){A\ fun dup() = 1
}
\test_expect_error("function.duplicate_parameter"){B\ fun dup_param(x, x) = x
}
\test_expect_error("function.duplicate_parameter"){C\ fun dup_param2(x, y, x) = x + y
}
}

\test_output{
a
b
c
d
e
A
B
C
}
